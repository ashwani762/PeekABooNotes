<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for PeekABoo Notes. build-msix.ps1 stages this beside the exe, lang\ and
  Assets\ and fills in the version. Publisher must equal the signing certificate's subject.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap desktop rescap uap3 desktop4 desktop6">

  <Identity
    Name="PeekABooNotes"
    Publisher="CN=PeekABoo Notes Dev"
    Version="0.6.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PeekABoo Notes</DisplayName>
    <PublisherDisplayName>PeekABoo Notes</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Edge-docked sticky notes for Windows with a tiny memory footprint</Description>
    <!-- Settings > Connect writes assistants' own config files (Claude Desktop's is in
         %APPDATA%): they must land in the real folder, not the package's private copy. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PeekABooNotes" Executable="peekaboo-notes.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PeekABoo Notes"
        Description="Edge-docked sticky notes"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Start with Windows (Settings toggle -> StartupTask API in src/app/files.rs). -->
        <desktop:Extension Category="windows.startupTask" Executable="peekaboo-notes.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="PeekABooNotesStartup" Enabled="false" DisplayName="PeekABoo Notes" />
        </desktop:Extension>
      </Extensions>
    </Application>
    <!-- The MCP bridge for AI assistants: a console program with a command on PATH
         (peekaboo-mcp.exe), since the package's own folder moves with every version. -->
    <Application Id="PeekABooMcp" Executable="peekaboo-mcp.exe" EntryPoint="Windows.FullTrustApplication" desktop4:Subsystem="console" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="PeekABoo Notes MCP"
        Description="Lets AI assistants use PeekABoo Notes"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="peekaboo-mcp.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="peekaboo-mcp.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
