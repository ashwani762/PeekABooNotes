<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for PeekABoo Notes. build-msix.ps1 stages this beside the exe, lang\ and
  Assets\ and fills in the version. Publisher must equal the signing certificate's subject.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="PeekABooNotes"
    Publisher="CN=PeekABoo Notes Dev"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PeekABoo Notes</DisplayName>
    <PublisherDisplayName>PeekABoo Notes</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Edge-docked sticky notes for Windows with a tiny memory footprint</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PeekABooNotes" Executable="peekaboo-notes.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PeekABoo Notes"
        Description="Edge-docked sticky notes"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Start with Windows (Settings toggle -> StartupTask API in src/app/files.rs). -->
        <desktop:Extension Category="windows.startupTask" Executable="peekaboo-notes.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="PeekABooNotesStartup" Enabled="false" DisplayName="PeekABoo Notes" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
