<?xml version="1.0" encoding="utf-8"?>
<!--
  PeekABoo Notes interface text: English (the reference language).

  To translate: copy this file to strings.<language-tag>.xml (strings.it.xml,
  strings.pt-BR.xml, ...), translate the text between the tags and keep every
  name="..." unchanged. Put the file in a "lang" folder next to peekaboo-notes.exe or in the
  notes folder; it appears under Settings > General > Language.

  Placeholders: %s / %d in order, or %1$s / %2$d by position (reorder freely).
  %% is a percent sign. Plurals use CLDR categories: zero, one, two, few, many, other.
-->
